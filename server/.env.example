# Keep this key on the server. Never place it in Flutter code or a web build.
OPENAI_API_KEY=

# GPT-5.6 Terra balances capability and cost for the interactive assistant.
PILLAI_OPENAI_MODEL=gpt-5.6-terra

# Required with OPENAI_API_KEY. Use at least 32 random characters to HMAC
# client IDs; the server fails fast if this is missing or weak.
PILLAI_SAFETY_ID_SECRET=replace-with-a-long-random-secret

# Optional server settings.
PORT=8787
# Loopback is the safe default. Use 0.0.0.0 only for a trusted LAN/device demo;
# a public deployment also needs HTTPS, authentication, and rate limiting.
HOST=127.0.0.1
PILLAI_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
PILLAI_OPENAI_TIMEOUT_MS=35000
# Set false only for offline/private deployments. Product-specific answers will
# then abstain when the saved record does not contain enough evidence.
PILLAI_WEB_SEARCH_ENABLED=true
# AI-proposed reminder-time changes (the "living schedule"). Interaction-based
# rescheduling is likely Software-as-a-Medical-Device in Saudi Arabia (SFDA
# MDS-G027). Set false for an organizer-only public release until SFDA has
# confirmed the product classification in writing.
PILLAI_SCHEDULE_PROPOSALS=true
